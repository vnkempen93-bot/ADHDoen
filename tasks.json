{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Remove emoties image",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Remove-Item -LiteralPath '.\\assets\\emoties 1 .jpeg' -Force"
			],
			"isBackground": false
		},
		{
			"label": "Remove emoties image quoted",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Remove-Item -LiteralPath \"./assets/emoties 1 .jpeg\" -Force"
			],
			"isBackground": false
		},
		{
			"label": "Delete emoties via cmd",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"del /f /q \"assets\\emoties 1 .jpeg\""
			],
			"isBackground": false
		},
		{
			"label": "List assets short names",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"dir /x assets"
			],
			"isBackground": false
		},
		{
			"label": "Delete emotions shortname",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"del /f /q assets\\EMOTIE~1.JPE"
			],
			"isBackground": false
		}
	]
}